   <item>
    <widget class="QFrame" name="frame_contenedor_general">
     <property name="styleSheet">
      <string notr="true">QFrame {
    background-color: #0b181c;        /* Azul muy oscuro, base profunda */
    border: 2px solid #4dd0e1;        /* Borde cian brillante */
    border-radius: 12px;
    padding: 10px;
}

/* Opcional: si el frame contiene otros frames o etiquetas internas */
QFrame &gt; QLabel {
    color: #b3e5fc;
    background-color: transparent;
}

QPushButton {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #14424b, stop:1 #0b181c
    );                                      /* Degradado frío */
    color: #e0f7fa;
    border: 2px solid #4dd0e1;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 14px;
    font-family: 'Segoe UI', 'Ubuntu', sans-serif;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 150ms ease-in-out;
    box-shadow: 0 0 6px rgba(77, 208, 225, 0.3);   /* Sutil resplandor */
}

QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1f5966, stop:1 #14424b
    );
    border: 2px solid #80deea;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(128, 222, 234, 0.5); /* Más brillo */
    transform: scale(1.02);                       /* Ligero agrandamiento */
}

QPushButton:pressed {
    background-color: #0a2a33;
    border: 2px solid #00bcd4;
    color: #b2ebf2;
    box-shadow: 0 0 12px rgba(0, 188, 212, 0.6);
    transform: scale(0.98);
}

QPushButton:disabled {
    background-color: #1c313a;
    color: #607d8b;
    border: 1px solid #455a64;
    box-shadow: none;
}</string>
